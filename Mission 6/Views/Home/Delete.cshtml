@{
}
@model Movie
<h2>Confirm Deletion</h2> @* Display Text *@
<h3>@Model.Title</h3> @* Display the title of the movie being deleted *@

@* Form to confirm movie deletion *@
<form asp-controller="Home" asp-action="Delete" method="post">
    <input type ="hidden" asp-for="MovieId" />
    <button type="submit">Delete</button>
    <a class="btn btn-info" asp-controller="Home" asp-action="MovieList">Cancel</a>
</form>
