@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@* Specifies that this view expects a list of Movie objects *@
@model List<Movie> 

<table class="table table-bordered">
    <thead class="fw-bold">
        @* Table headers *@
        <tr>
            <td>Category</td>
            <td>Title</td>
            <td>Year</td>
            <td>Director</td>
            <td>Rating</td>
            <td>Edited</td>
            <td>LentTo</td>
            <td>CopiedToPlex</td>
            <td>Notes</td>
            <td>Edit?</td>
            <td>Delete?</td>
        </tr>
    </thead>

    @* Loop through each movie in the list and display its details *@
    @foreach (var x in Model)
    {
    <tbody>
        <tr>
			<td>@x.Category?.CategoryName</td>
			<td>@x.Title</td>
			<td>@x.Year</td>
			<td>@x.Director</td>
			<td>@x.Rating</td>
			<td>@x.Edited</td>
			<td>@x.LentTo</td>
            <td>@x.CopiedToPlex</td>
			<td>@x.Notes</td>

            @* Action buttons for editing and deleting a movie *@
            <td><a class="btn btn-info" asp-controller="Home" asp-action="Edit" asp-route-id="@x.MovieId">Edit</a></td>
            <td><a class="btn btn-danger" asp-controller="Home" asp-action="Delete" asp-route-id="@x.MovieId">Delete</a></td>
        </tr>
       
    </tbody>
    }
</table>
